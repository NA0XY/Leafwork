# ============================================================
# Leafwork Environment Variables
# Copy this file to .env.local and fill in your values.
# All services below have free tiers - no card required.
# ============================================================

# App URL
# Development: https://leafworkpdf.vercel.app
# Production:  https://leafworkpdf.app (once domain is live)
NEXT_PUBLIC_BASE_URL=https://leafworkpdf.vercel.app

# Supabase
# Get from: supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
# WARNING: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose to client.

# Groq
# Get from: console.groq.com -> API Keys (no credit card required)
GROQ_API_KEY=gsk_...your-groq-key...

# Upstash Redis
# Get from: console.upstash.com -> Create Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Google Search Console verification (get from search.google.com/search-console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Build
# Set automatically by Vercel. Do not set manually.
# VERCEL_GIT_COMMIT_SHA=
